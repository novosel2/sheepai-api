# JWT — use a strong random secret (e.g. openssl rand -base64 64)
JWT_SECRET=your-secret-here
JWT_ISSUER=https://yourdomain.com
JWT_AUDIENCE=sheepai
JWT_EXPIRES_MINUTES=15
JWT_REFRESH_EXPIRY_DAYS=7

# Anthropic — platform.anthropic.com → API keys
CLAUDE_API_KEY=sk-ant-your-key-here
CLAUDE_DEFAULT_MODEL=claude-opus-4-6
CLAUDE_MAX_TOKENS=4096

# Supabase Postgres — Dashboard → Project Settings → Database → Connection string (URI)
DATABASE_CONNECTION_STRING=Host=db.your-project-ref.supabase.co;Port=5432;Database=postgres;Username=postgres;Password=your-password;SSL Mode=Require;Trust Server Certificate=true

# CORS allowed origins
CORS_ALLOWED_ORIGINS_0=http://localhost:3000
CORS_ALLOWED_ORIGINS_1=http://localhost:5173

# Rate limiting
RATE_LIMIT_PERMIT=20
RATE_LIMIT_WINDOW_SECONDS=60

# Redis
REDIS_CONNECTION=localhost:6379
