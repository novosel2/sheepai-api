{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "SheepAI": "Information",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Error",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/sheepai-.log",
          "rollingInterval": "Day"
        }
      }
    ],
    "Enrich": ["FromLogContext", "WithMachineName", "WithThreadId"]
  },
  "Cache": {
    "Ttl": { "Short": 5, "Medium": 15, "Long": 20, "VeryLong": 60 }
  },
  "AllowedHosts": "*"
}
